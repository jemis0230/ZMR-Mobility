generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Lets single-vehicle reads load their relations in one SQL query
  // (relationLoadStrategy: 'join') instead of one round trip per relation.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum VehicleCategory {
  TWO_WHEELER
  THREE_WHEELER_CARGO
  THREE_WHEELER_PASSENGER
  FOUR_WHEELER_PASSENGER
  FOUR_WHEELER_CARGO
}

enum ChargerType {
  NORMAL
  FAST
  BOTH
}

/// Distinguishes scooters from motorcycles within TWO_WHEELER (Body Type filter).
enum TwoWheelerStyle {
  SCOOTER
  BIKE
}

enum TransmissionType {
  AUTO
  MANUAL
  SEMI_AUTO
}

enum InquiryType {
  VEHICLE_LEASING
  VEHICLE_RENTING
  VEHICLE_PURCHASE
  CORPORATE_ENTERPRISE
  FLEET_LOGISTICS
  DEALERSHIP_FRANCHISE
  B2B_PARTNERSHIP
  TEST_DRIVE
  OTHER
}

enum LeadStatus {
  PENDING
  CONTACTED
  QUALIFIED
  CLOSED_WON
  CLOSED_LOST
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum SellStatus {
  NEW
  REVIEWING
  VALUED
  ACCEPTED
  REJECTED
}

// ── Vehicle Lookup Tables ─────────────────────────────────────────────────────

model BatteryType {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MotorType {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ── Vehicle ────────────────────────────────────────────────────────────────────

model Vehicle {
  id              String           @id @default(cuid())
  make            String
  model           String
  category        VehicleCategory
  /// Scooter or bike, for two-wheelers only. Unset two-wheelers are treated as scooters.
  twoWheelerStyle TwoWheelerStyle?
  warranty        String           @default("")
  mainImage       String

  // Visibility flags — controls which section(s) this vehicle appears in
  showInLeasing Boolean @default(false)
  showInBuying  Boolean @default(false)
  showInRent    Boolean @default(false)

  // Buying price (flat; leasing & rent pricing live in plan tables)
  buyingPrice Float?

  // ── Pre-owned details (used for Year / KM Driven filters) ─────────
  manufactureYear Int?
  kmDriven        Int?

  // ── Performance ───────────────────────────────────────────────────
  certifiedRangeKm Int
  realWorldRangeKm Int?
  topSpeedKmh      Int

  // ── Battery & Drivetrain ──────────────────────────────────────────
  batteryCapKwh  Float
  batteryTypeId  String?
  batteryType    BatteryType?     @relation(fields: [batteryTypeId], references: [id], onDelete: SetNull)
  peakVoltageV   Int?
  motorTypeId    String?
  motorType      MotorType?       @relation(fields: [motorTypeId], references: [id], onDelete: SetNull)
  peakPowerKw    Float?
  peakTorqueNm   Float?
  transmission   TransmissionType @default(AUTO)
  gradabilityPct Float?

  // ── Charging ──────────────────────────────────────────────────────
  chargingTimeMinutes Int         @default(0) // stored as total minutes e.g. 90 = 1h 30m
  chargerType         ChargerType @default(NORMAL)
  hasOnBoardCharger   Boolean     @default(true)

  // ── Dimensions (SI units throughout) ─────────────────────────────
  curbWeightKg      Float  @default(0)
  grossWeightKg     Float?
  widthMm           Float  @default(0)
  heightMm          Float  @default(0)
  lengthMm          Float  @default(0)
  groundClearanceMm Float  @default(0)
  wheelbaseMm       Float  @default(0)

  // ── Cargo-specific (null for non-cargo categories) ────────────────
  payloadKg           Float?
  cargoVolumeL        Float?
  containerDimensions String?

  // ── Rich-text descriptions ────────────────────────────────────────
  overview    String?
  techSpecs   String?
  performance String?
  leasingInfo String?
  buyingInfo  String?
  rentalInfo  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     VehicleImage[]
  leasePlans LeasePlan[]
  rentPlans  RentPlan[]

  @@index([category])
  @@index([make])
  @@index([chargerType])
  @@index([category, make])
  @@index([showInLeasing])
  @@index([showInBuying])
  @@index([showInRent])
  @@index([batteryTypeId])
  @@index([motorTypeId])
  @@index([buyingPrice])
  @@index([manufactureYear])
  @@index([kmDriven])
}

// Replaces comma-separated sideImages — fixes 1NF violation
model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([vehicleId])
}

// ── Pricing Plans ──────────────────────────────────────────────────────────────

model LeasePlan {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenureMonths   Int // 12 | 24 | 36
  monthlyPriceRs Float
  depositRs      Float
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vehicleId, tenureMonths]) // BCNF: one plan per vehicle per tenure
  @@index([vehicleId, isActive])
}

model RentPlan {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  durationDays  Int // 1 | 7 | 30
  pricePerDayRs Float
  depositRs     Float
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([vehicleId, durationDays])
  @@index([vehicleId, isActive])
}

// ── CRM ───────────────────────────────────────────────────────────────────────

model Lead {
  id            String             @id @default(cuid())
  name          String
  phone         String
  email         String?
  state         String             @default("")
  city          String             @default("")
  inquiryType   InquiryType
  vehicleId     String?
  vehicleName   String? // snapshot — vehicle may be deleted later
  /// Test drives: the customer's preferred date (a preference, not a confirmed slot).
  preferredDate DateTime?          @db.Date
  notes         String?
  status        LeadStatus         @default(PENDING)
  /// Short reference shown to staff and in notifications, e.g. ZMR-L-7K3QX9 (null for older leads).
  reference     String?            @unique
  /// Which website form created the lead (contact-form, vehicle-enquiry, test-drive).
  source        String?
  notifications LeadNotification[]
  createdAt     DateTime           @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

// ── Content ───────────────────────────────────────────────────────────────────

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  // Optional policy topic (warranty, ownership_transfer, noc, insurance, buyback).
  // Topic FAQs feed the "Warranty & Ownership Support" section; null = general FAQ.
  topic     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic])
}

// ── Press & Media ─────────────────────────────────────────────────────────────

model PressMention {
  id          String    @id @default(cuid())
  publication String
  title       String
  url         String
  publishedAt DateTime?
  imageUrl    String? // publication logo or article image (only where authorised)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, publishedAt])
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String?
  coverImage String?
  category   String
  /// Legacy free-text tags, copied into BlogTag/BlogPostTag by migration 20261015000000; no longer read.
  tags       String[]
  published  Boolean  @default(false)
  authorName String   @default("ZMR Mobility Team")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Byline: the author record plus a per-post snapshot of the name (authorName) and
  // designation, so editing an author never silently rewrites published bylines.
  authorId          String?
  author            BlogAuthor?   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorDesignation String?
  typeId            String?
  type              BlogType?     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  publishedAt       DateTime?
  tagLinks          BlogPostTag[]

  @@index([published])
  @@index([category])
  @@index([published, createdAt])
  @@index([authorId])
  @@index([typeId])
}

model BlogAuthor {
  id          String     @id @default(cuid())
  name        String
  /// Lower-cased, whitespace-collapsed name; keeps author names unique regardless of case.
  nameKey     String     @unique
  designation String
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BlogType {
  id        String     @id @default(cuid())
  name      String
  nameKey   String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model BlogTag {
  id        String            @id @default(cuid())
  name      String
  nameKey   String            @unique
  slug      String            @unique
  posts     BlogPostTag[]
  redirects BlogTagRedirect[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

/// Old tag slugs (from renames and merges) that should still resolve to a tag.
model BlogTagRedirect {
  fromSlug  String   @id
  tagId     String
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tagId])
}

// ── EV Brand Catalogue ────────────────────────────────────────────────────────

model EvBrand {
  id         String            @id @default(cuid())
  name       String
  categories VehicleCategory[]
  isActive   Boolean           @default(true)
  models     EvBrandModel[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model EvBrandModel {
  id        String          @id @default(cuid())
  name      String
  brandId   String
  brand     EvBrand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  photo     String?
  category  VehicleCategory
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([brandId])
}

// ── Sell Applications ─────────────────────────────────────────────────────────

model SellApplication {
  id            String          @id @default(cuid())
  applicationId String          @unique
  category      VehicleCategory
  sellerType    String

  // Brand & model snapshot (name kept even if brand/model is deleted)
  brandId   String
  brandName String
  modelId   String
  modelName String

  year             Int
  ownership        String
  batteryCondition String
  vehicleCondition String
  hasAccident      Boolean
  loanStatus       String
  documents        String[]
  expectedPriceRs  Float

  contactName  String
  contactPhone String
  contactEmail String
  contactCity  String

  status        SellStatus         @default(NEW)
  adminNotes    String?
  notifications LeadNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Admin ─────────────────────────────────────────────────────────────────────

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String    @default("")
  passwordHash   String
  role           AdminRole @default(ADMIN)
  isActive       Boolean   @default(true)
  /// Bumped on sign-out, password change/reset and deactivation; sessions carrying an
  /// older value are rejected, so those events end every existing session.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
}

// ── Lead notifications (database-backed outbox) ──────────────────────────────

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  QUEUED // waiting for (re)delivery
  SENDING // claimed by a worker
  ACCEPTED // provider accepted the message
  DELIVERED // provider confirmed delivery (WhatsApp webhook)
  READ // provider reported it read (WhatsApp webhook)
  FAILED // gave up (permanent error or attempts exhausted); staff can retry
  NOT_CONFIGURED // channel settings missing when processed; staff can retry later
}

/// One row per lead (or sell application) and channel; unique so a lead is never
/// notified twice on the same channel by repeated submissions or workers.
model LeadNotification {
  id                 String              @id @default(cuid())
  leadId             String?
  lead               Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sellApplicationId  String?
  sellApplication    SellApplication?    @relation(fields: [sellApplicationId], references: [id], onDelete: Cascade)
  channel            NotificationChannel
  status             NotificationStatus  @default(QUEUED)
  attempts           Int                 @default(0)
  maxAttempts        Int                 @default(5)
  nextAttemptAt      DateTime            @default(now())
  lockedUntil        DateTime?
  /// Recipients the provider already accepted, so a retry never re-sends to them.
  sentTo             String[]            @default([])
  providerMessageIds String[]            @default([])
  lastError          String?
  acceptedAt         DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([leadId, channel])
  @@unique([sellApplicationId, channel])
  @@index([status, nextAttemptAt])
}

/// Fixed-window counters for login throttling and public form rate limits.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
