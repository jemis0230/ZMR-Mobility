# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=zmr_db
POSTGRES_USER=zmr
POSTGRES_PASSWORD=change_me_strong_password_here

# ── Application ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate_with_openssl_rand_base64_32

# Password for the first superadmin account (askhammad000@gmail.com)
SEED_ADMIN_PASSWORD=ChangeMe@123!

# ── Domain (used by Caddy for automatic HTTPS) ────────────────
DOMAIN=yourdomain.com

# ── Google Analytics 4 (baked in at build time — paste your GA4 Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R00S910MCX

# ── Image uploads (Vercel Blob; set automatically when a Blob store is connected) ──
BLOB_READ_WRITE_TOKEN=

# ── Links in notifications (public URL of this deployment, no trailing slash) ──
APP_BASE_URL=

# ── Scheduled notification worker (long random string; Vercel Cron and the
#    self-hosted "notifier" container send it as "Authorization: Bearer <value>") ──
CRON_SECRET=

# ── Lead notifications: email (SMTP of an authenticated mailbox) ─────────────
SMTP_HOST=
SMTP_PORT=465
# true for port 465 (TLS), false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Authenticated sender, e.g. "ZMR Mobility Leads <leads@your-domain>"
LEAD_EMAIL_FROM=
# Approved staff recipients, comma-separated
LEAD_NOTIFY_EMAIL_TO=

# ── Lead notifications: WhatsApp Business Platform (Cloud API) ────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved staff numbers in international format, comma-separated, e.g. +9190000xxxxx
WHATSAPP_LEAD_RECIPIENTS=
# Approved utility template with 5 body variables (see docs/LEAD_NOTIFICATIONS.md)
WHATSAPP_LEAD_TEMPLATE=
WHATSAPP_LEAD_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v21.0
# Webhook (delivery statuses): verify token you choose + the Meta app secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
